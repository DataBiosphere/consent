{
  "example": "assets, Intellectual Property tab with a date range",
  "source": "docs/plans/typed-search-assets-registry.md#4-filter-keys",
  "user": { "roles": ["RESEARCHER"] },
  "request": {
    "view": "assets",
    "assetType": "intellectual_properties",
    "scope": { "library": null },
    "filters": [ {"key": "ipFiledDate", "gte": "2020-01-01"} ],
    "sort": { "key": "filingDate", "order": "desc" }
  },
  "response": {
    "status": 200,
    "body": {
      "view": "assets",
      "total": 1,
      "page": { "offset": 0, "limit": 25 },
      "results": [
        {
          "studyId": 7,
          "studyName": "Heart Study",
          "assetKey": "pos:0",
          "ipId": "IP-1",
          "type": "Patent",
          "title": "Cardiac marker",
          "assignee": "Example University",
          "patentNumber": "US0000000",
          "filingDate": "2021-04-01",
          "status": "Granted",
          "contact": "ip@example.org"
        }
      ]
    }
  }
}
