{
  "example": "assets 1.7, a filter of another asset type",
  "source": "docs/plans/typed-search-examples-assets.md#17-a-filter-of-another-asset-type",
  "user": { "roles": ["RESEARCHER"] },
  "request": {
    "view": "assets",
    "assetType": "models",
    "scope": { "library": null },
    "filters": [ {"key": "publicationJournal", "values": ["Nature Genetics"]} ],
    "page": { "offset": 0, "limit": 25 }
  },
  "response": {
    "status": 200,
    "body": {
      "view": "assets",
      "total": 2,
      "page": { "offset": 0, "limit": 25 },
      "results": [
        {
          "studyId": 7,
          "studyName": "Heart Study",
          "assetKey": "id:45",
          "modelId": 45,
          "duosIdentifier": "DUOS-M-000045",
          "name": "Arrhythmia Classifier",
          "description": "Classifies ECG traces.",
          "url": "https://example.org/models/45",
          "format": "ONNX",
          "license": "MIT",
          "cloud": [ "GCP" ],
          "trainedOnDatasets": [ "DUOS-000101" ],
          "maintainer": { "name": "Example Maintainer", "email": "maintainer@example.org" },
          "tags": [ "cardiology" ]
        }
      ]
    }
  }
}
