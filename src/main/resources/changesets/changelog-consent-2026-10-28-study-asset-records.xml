    </createIndex>
    <sql>CREATE UNIQUE INDEX uq_study_biospecimen_legacy_key ON study_biospecimen (study_id, legacy_key) WHERE legacy_key IS NOT NULL</sql>

    <!-- True when an asset id in the registration JSON could be a row id: a positive int4, as a number or plain digits. -->
    <sql splitStatements="false">
      CREATE FUNCTION asset_id_in_row_form(id jsonb) RETURNS boolean
      LANGUAGE sql IMMUTABLE AS $$
        SELECT CASE jsonb_typeof(id)
          WHEN 'string' THEN CASE WHEN id #>> '{}' ~ '^[1-9][0-9]{0,9}$'
                                  THEN (id #>> '{}')::bigint &lt;= 2147483647
                                  ELSE false END
          WHEN 'number' THEN id::numeric BETWEEN 1 AND 2147483647 AND id::numeric = trunc(id::numeric)
          ELSE false
        END
      $$
    </sql>
  </changeSet>
</databaseChangeLog>
