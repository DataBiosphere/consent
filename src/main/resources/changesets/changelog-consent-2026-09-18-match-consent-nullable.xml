<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
  <!--
    This release stops writing match_entity.consent, so the column has to accept the null it now
    leaves behind.

    It is a release of its own because each neighbour has to be everywhere before it can follow. The
    previous release stopped reading the column; until it is everywhere, an instance that still
    reads it serves a null `consent` for any row written here. The next release drops the column;
    until this one is everywhere, an instance that still writes it fails every insert.

    purpose_consent survives this release harmlessly: Postgres unique constraints ignore nulls, so
    rows written after it never collide on it, and match_entity_purpose_dataset_unique has enforced
    the real rule since the dataset_id constraints were applied.
  -->
  <changeSet id="changelog-consent-2026-09-18-match-consent-nullable" author="kmarete">
    <!-- The snapshot tables are gone only if the release that stopped reading the column applied
         its changeset here; without it, this release's nulls reach a reader that still wants a
         value. -->
    <preConditions onFail="HALT" onError="HALT"
      onFailMessage="The release that stops reading match_entity.consent must have applied here first; its changeset drops match_migration_snapshot, which is still present. Deploy that release before this one.">
      <dbms type="postgresql"/>
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM pg_class
        WHERE relname IN ('match_migration_snapshot', 'match_migration_rationale_snapshot')
          AND relnamespace = 'public'::regnamespace
      </sqlCheck>
    </preConditions>

    <dropNotNullConstraint tableName="match_entity" columnName="consent"
      columnDataType="varchar(255)"/>

    <rollback>
      <!-- Restoring the constraint means the rows written since have to carry a value again, and
           the dataset each one points at is the only place left to get it. The ::BIGINT is
           load-bearing: alias is numeric in some environments, where 42.0 satisfies the
           alias = trunc(alias) check and would otherwise render as DUOS-0042.0. -->
      <sql>
        UPDATE match_entity m
        SET consent =
          'DUOS-' || LPAD(d.alias::BIGINT::TEXT, GREATEST(6, LENGTH(d.alias::BIGINT::TEXT)), '0')
        FROM dataset d
        WHERE d.dataset_id = m.dataset_id AND m.consent IS NULL
      </sql>
      <addNotNullConstraint tableName="match_entity" columnName="consent"
        columnDataType="varchar(255)"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
