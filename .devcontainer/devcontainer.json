{
    "name": "Java 25",
    "image": "mcr.microsoft.com/devcontainers/java:25",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "25",
            "jdkDistro": "tem",
            "installMaven": true
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "moby": false
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "1.36.3",
            "helm": "4.2.3",
            "minikube": "none"
        }
    },
    "postCreateCommand": "./scripts/setup-devcontainer.sh",
    "portsAttributes": {
        "27443": { "label": "Consent proxy", "onAutoForward": "notify" },
        "7777": { "label": "Consent debugger", "onAutoForward": "silent" },
        "9200": { "label": "Elasticsearch", "onAutoForward": "silent" }
    },
    "initializeCommand": "mkdir -p \"$HOME/.claude\" \"$HOME/.codex\"",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
        "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "CODEX_HOME": "/home/vscode/.codex"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt"
            ]
        }
    },
    "remoteUser": "vscode"
}
